From 789730506b2341568b9e709a660226e95087c49f Mon Sep 17 00:00:00 2001
From: Lynne <dev@lynne.ee>
Date: Tue, 22 Sep 2026 01:19:31 +0900
Subject: [PATCH] vulkan/prores_ks_slice_data: add the missing barrier before
 the first DCT

Each invocation loads one row of its block into shared memory, and the
first DCT pass then transforms a column, which spans the rows of the
other invocations.

---
 libavcodec/vulkan/prores_ks_slice_data.comp.glsl | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/libavcodec/vulkan/prores_ks_slice_data.comp.glsl b/libavcodec/vulkan/prores_ks_slice_data.comp.glsl
index be87b7e03a..7f264eeac6 100644
--- a/libavcodec/vulkan/prores_ks_slice_data.comp.glsl
+++ b/libavcodec/vulkan/prores_ks_slice_data.comp.glsl
@@ -144,12 +144,13 @@ void main()
         int c = imageLoad(planes[plane], coord + ivec2(i, 0)).x;
         blocks[slice_block][row * 9 + i] = float(c) / (1 << (bits_per_sample - 1));
     }
-
-    /* Row-wise DCT */
-    fdct8(slice_block, row, 9);
     barrier();
 
     /* Column-wise DCT */
+    fdct8(slice_block, row, 9);
+    barrier();
+
+    /* Row-wise DCT */
     fdct8(slice_block, row*9, 1);
     barrier();
 
-- 
