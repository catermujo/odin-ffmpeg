+duration=1024
 flags=K__
 [/PACKET]
 [PACKET]
-pts=89920
-dts=89920
-duration=128
+pts=47680
+dts=47680
+duration=1024
 flags=K__
 [/PACKET]
 [PACKET]
-pts=90048
-dts=90048
-duration=128
+pts=48704
