 libavformat/oggparsevorbis.c                  |  8 ++-
 tests/ref/fate/mov-mp4-chapters               | 39 +++++++-------
 tests/ref/fate/ogg-vorbis-bear                |  2 +-
 .../fate/ogg-vorbis-initial-padding-chained   |  6 +--
 tests/ref/fate/ogg-vorbis-libvorbis-1s        |  4 +-
 tests/ref/fate/ogg-vorbis-libvorbis-30s       |  4 +-
 tests/ref/fate/ogg-vorbis-ts-seek             |  6 +--
 tests/ref/fate/webm-dash-chapters             | 54 +++++++++----------
 8 files changed, 65 insertions(+), 58 deletions(-)

diff --git a/libavformat/oggparsevorbis.c b/libavformat/oggparsevorbis.c
index b4a1cfb..3ad72cd 100644
--- a/libavformat/oggparsevorbis.c
+++ b/libavformat/oggparsevorbis.c
@@ -500,8 +500,14 @@ static int vorbis_packet(AVFormatContext *s, int idx)
     /* Initial position shift to account for encoder delay, or page scan
      * to recover the page start timestamp after a seek. */
     if (bos) {
-        if (os->lastpts != AV_NOPTS_VALUE)
+        if (os->lastpts != AV_NOPTS_VALUE) {
+            if (s->streams[idx]->start_time == AV_NOPTS_VALUE) {
+                s->streams[idx]->start_time = os->lastpts;
+                if (s->streams[idx]->duration != AV_NOPTS_VALUE)
+                    s->streams[idx]->duration -= s->streams[idx]->start_time;
+            }
             os->lastpts -= priv->ts_offset;
+        }
         if (os->lastdts != AV_NOPTS_VALUE)
             os->lastdts -= priv->ts_offset;
     } else if (os->page_start && os->lastpts == AV_NOPTS_VALUE &&
