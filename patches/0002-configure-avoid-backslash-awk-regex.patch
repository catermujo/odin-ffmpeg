From 7b1d69557c0ca36d6b31a9a9f4c61c3c3f1e1e4a Mon Sep 17 00:00:00 2001
From: Catermujo <noreply@catermujo.local>
Date: Wed, 26 Aug 2026 11:30:00 -0300
Subject: [PATCH] configure: avoid backslash awk regex on Windows

GNU Make for Windows removes one level of backslash escaping before the
dependency rule reaches awk. Match the backslash by character code instead,
passing two backslashes to awk's dynamic regular-expression parser.

---
 configure | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configure b/configure
index 59cc3b8d2b993478e0ac48cde82503bee868d43f..6d1225fa7e78902e54f83bcc530719025284ed71 100755
--- a/configure
+++ b/configure
@@ -5483,7 +5483,7 @@ probe_cc(){
             _DEPCMD='$(DEP$(1)) $(DEP$(1)FLAGS) $($(1)DEP_FLAGS) $< 2>&1 | awk '\''/including/ { sub(/^.*file: */, ""); if (!match($$0, / /)) { print $$0 } }'\'' | xargs -r -d\\n -n1 wslpath -u | awk '\''BEGIN { printf "%s:", "$@" }; { sub(/\r/,""); printf " %s", $$0 }; END { print "" }'\'' > $(@:.o=.d)'

         else
-            _DEPCMD='$(DEP$(1)) $(DEP$(1)FLAGS) $($(1)DEP_FLAGS) $< 2>&1 | awk '\''/including/ { sub(/^.*file: */, ""); gsub(/\\/, "/"); if (!match($$0, / /)) print "$@:", $$0 }'\'' > $(@:.o=.d)'
+            _DEPCMD='$(DEP$(1)) $(DEP$(1)FLAGS) $($(1)DEP_FLAGS) $< 2>&1 | awk '\''/including/ { sub(/^.*file: */, ""); gsub(sprintf("%c%c", 92, 92), "/"); if (!match($$0, / /)) print "$@:", $$0 }'\'' > $(@:.o=.d)'
         fi
         _DEPFLAGS='$(CPPFLAGS) -showIncludes -Zs'
         _DEPCCFLAGS='$(CFLAGS)'
